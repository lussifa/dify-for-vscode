{
  "name": "dify-for-vscode",
  "displayName": "Dify for VS Code",
  "description": "A native VS Code coding agent powered directly by a Dify Chatflow.",
  "version": "0.1.2",
  "publisher": "lussifa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lussifa/dify-for-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/lussifa/dify-for-vscode/issues"
  },
  "homepage": "https://github.com/lussifa/dify-for-vscode#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["AI", "Other"],
  "keywords": ["dify", "chatflow", "ai", "agent", "coding"],
  "activationEvents": [
    "onView:difyForVscode.chatView",
    "onCommand:difyForVscode.configure",
    "onCommand:difyForVscode.newChat",
    "onCommand:difyForVscode.toggleYolo",
    "onCommand:difyForVscode.checkUpdates"
  ],
  "main": "./compat.js",
  "icon": "media/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "difyForVscode.configure",
        "title": "Dify for VS Code: Configure"
      },
      {
        "command": "difyForVscode.newChat",
        "title": "Dify for VS Code: New Chat"
      },
      {
        "command": "difyForVscode.toggleYolo",
        "title": "Dify for VS Code: Toggle YOLO Mode"
      },
      {
        "command": "difyForVscode.checkUpdates",
        "title": "Dify for VS Code: Check for Updates"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "difyForVscode",
          "title": "Dify",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "difyForVscode": [
        {
          "type": "webview",
          "id": "difyForVscode.chatView",
          "name": "Dify Agent"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "difyForVscode.newChat",
          "when": "view == difyForVscode.chatView",
          "group": "navigation"
        },
        {
          "command": "difyForVscode.configure",
          "when": "view == difyForVscode.chatView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Dify for VS Code",
      "properties": {
        "difyForVscode.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1/v1",
          "description": "Dify API base URL. Use the /v1 base, not /v1/chat-messages."
        },
        "difyForVscode.userId": {
          "type": "string",
          "default": "vscode-agent",
          "description": "User identifier sent to Dify."
        },
        "difyForVscode.yoloMode": {
          "type": "boolean",
          "default": false,
          "description": "Automatically execute mutating tools and shell commands without confirmation."
        },
        "difyForVscode.maxAgentSteps": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum Dify/tool loop steps for one user request."
        },
        "difyForVscode.commandTimeoutMs": {
          "type": "number",
          "default": 120000,
          "minimum": 1000,
          "maximum": 600000,
          "description": "Timeout for run_command in milliseconds."
        },
        "difyForVscode.checkUpdatesOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Check the latest GitHub Release shortly after the extension starts."
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0"
  }
}
